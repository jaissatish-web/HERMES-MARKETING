# GATE HUB Core
PORT=8787
HOST=0.0.0.0
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://gatehub:change-me@localhost:5432/gatehub
DATABASE_SSL=false
DB_POOL_MAX=10
MAX_BODY_BYTES=1000000
SESSION_DAYS=7
SESSION_COOKIE_NAME=gate_hub_session
# 32+ random characters. Never commit the real value.
GATE_HUB_SECRET_KEY=replace-with-a-long-random-secret
# Optional first-run founder bootstrap. Prefer deployment secrets, not Git.
FOUNDER_EMAIL=
FOUNDER_NAME=Founder
FOUNDER_PASSWORD=
